# Cabeceras que Cloudflare Pages aplica al sitio desplegado.
# (Vite copia este archivo a dist/ y Cloudflare lo lee desde ahí.)

# ── Caché ──
# Los assets llevan hash en el nombre (index-a1b2c3.js), así que si cambia el
# contenido cambia el nombre: se pueden cachear para siempre sin riesgo.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# El HTML NO se cachea duro: así un despliegue nuevo se ve al instante y no
# queda una versión vieja pegada en el navegador o el CDN.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# ── Seguridad + permisos del metaverso ──
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  # HSTS: fuerza HTTPS durante 1 año (con subdominios) y habilita precarga.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # CSP: política pragmática que no rompe la app (Vite empaqueta sin inline JS;
  # los estilos en línea de React y Google Fonts necesitan 'unsafe-inline' en
  # style-src; MapLibre usa workers desde blob:; imágenes de mapas/almacenamiento
  # llegan por https). Si algún recurso se bloquea, ajustar la directiva concreta.
  # connect-src acotado a orígenes REALES (FE-02): backend (API+IA+SSE sobre esa
  # misma URL) y su wss para el canal realtime; Google Maps JS; los hosts de tiles
  # que consultan MapLibre/metaverso (OpenFreeMap para el basemap del Home —estilo,
  # teselas vectoriales, glyphs y sprites salen todos de tiles.openfreemap.org—,
  # ArcGIS y Carto para el metaverso) y el beacon de Cloudflare Web Analytics. Sin
  # comodín 'https:' → un XSS hipotético no exfiltra a cualquier host.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://maps.googleapis.com https://maps.gstatic.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https://api.dev.turismo-santander.desarrollos-pablo-carvajal.com wss://api.dev.turismo-santander.desarrollos-pablo-carvajal.com https://maps.googleapis.com https://maps.gstatic.com https://maps.google.com https://tiles.openfreemap.org https://tile.openstreetmap.org https://server.arcgisonline.com https://a.basemaps.cartocdn.com https://b.basemaps.cartocdn.com https://cloudflareinsights.com; worker-src 'self' blob:; frame-src 'self' https://www.openstreetmap.org https://www.google.com https://maps.google.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  # WebXR y sensores de orientación: el metaverso los necesita para el modo VR
  # y para "mirar alrededor" en móvil. Se habilitan solo para el propio sitio.
  # El resto de funciones potentes se DENIEGAN explícitamente (FE-06): cámara,
  # micrófono, geolocalización y pagos no se usan y quedan bloqueadas para todos.
  Permissions-Policy: xr-spatial-tracking=(self), accelerometer=(self), gyroscope=(self), magnetometer=(self), camera=(), microphone=(), geolocation=(), payment=()
